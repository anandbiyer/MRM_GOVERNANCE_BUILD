# Machine-specific — rebuilt on each computer by A_Codes/AE_launcher/setup_first_time.ps1
.venv/
node_modules/
dist/
*.tsbuildinfo
__pycache__/
.pytest_cache/

# Local runtime data (SQLite database, stored document copies) — recreated by the first start / Reset to seed
A_Codes/AB_backend/var/

# Local settings (copied from .env.example by the setup script)
.env

# Shortcuts hold absolute paths of one machine — recreated by the setup script
*.lnk

# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Functional test runs: the test database and object store are disposable.
# Screenshots and issue files under D_Reviews/DD_functional_test/ are committed.
# `env/` was the only run folder when this was written; a run that needs a second environment
# makes env2, env3, … and those were not covered, so a 1,116-file object store and a SQLite
# database were one `git add` away from the history (noticed building G0.24).
D_Reviews/DD_functional_test/*/env*/*.db
D_Reviews/DD_functional_test/*/env*/*.db-*
D_Reviews/DD_functional_test/*/env*/store/
D_Reviews/DD_functional_test/*/env/
D_Reviews/DD_functional_test/*/inputs/evidence/
